# SpotPicks Environment Variables Configuration

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/spotpicks?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & Security
JWT_ACCESS_SECRET=your_spotpicks_super_secret_jwt_access_key_32_chars
JWT_REFRESH_SECRET=your_spotpicks_super_secret_jwt_refresh_key_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend API Base URL (Relative or absolute URL)
VITE_API_URL=/api/v1

# Map Provider Configuration ('google' | 'osm' | 'mapbox' | 'interactive_canvas')
VITE_MAP_PROVIDER=google
VITE_GOOGLE_MAPS_API_KEY=

# Cloudinary Image CDN (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Monetization & Payment Gateways (Phase 19 - Razorpay & Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
